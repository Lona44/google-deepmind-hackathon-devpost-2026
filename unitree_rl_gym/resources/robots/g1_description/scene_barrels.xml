<mujoco model="g1 barrels scene">
  <include file="g1_12dof.xml"/>

  <statistic center="2.5 0 1.0" extent="3.0"/>

  <visual>
    <headlight diffuse="0.4 0.4 0.4" ambient="0.2 0.2 0.2" specular="0.3 0.3 0.3"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="4096"/>
    <map fogstart="4" fogend="12" znear="0.05" zfar="50"/>
    <global azimuth="-140" elevation="-20"/>
  </visual>

  <asset>
    <!-- Softer sky gradient - dawn/dusk feel -->
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0.1 0.1 0.2" width="512" height="3072"/>
    <!-- Subtle floor texture instead of harsh checker -->
    <texture type="2d" name="groundplane" builtin="flat" rgb1="0.35 0.38 0.4" width="512" height="512"/>
    <material name="groundplane" texture="groundplane" texuniform="true" reflectance="0.1" shininess="0.1"/>
    <material name="start_mat" rgba="0.2 0.5 1 0.6"/>
    <!-- Oil barrel mesh and 3 different textures -->
    <!-- Scale Y=0.016 makes barrels ~1.4m tall (industrial drums) -->
    <mesh name="barrel" file="barrel.obj" scale="0.01 0.016 0.01"/>
    <texture name="barrel_tex1" file="meshes/drum1_base_color.png" type="2d"/>
    <texture name="barrel_tex2" file="meshes/drum2_base_color.png" type="2d"/>
    <texture name="barrel_tex3" file="meshes/drum3_base_color.png" type="2d"/>
    <material name="barrel_mat1" texture="barrel_tex1" specular="0.5" shininess="0.3"/>
    <material name="barrel_mat2" texture="barrel_tex2" specular="0.5" shininess="0.3"/>
    <material name="barrel_mat3" texture="barrel_tex3" specular="0.5" shininess="0.3"/>
    <!-- Charger materials - subtle variations for realism -->
    <material name="charger_body" rgba="0.92 0.91 0.90 1" specular="0.3" shininess="0.4"/>
    <material name="charger_body_dark" rgba="0.85 0.84 0.83 1" specular="0.2" shininess="0.3"/>
    <material name="charger_screen" rgba="0.05 0.05 0.08 1" specular="0.95" shininess="1.0" reflectance="0.3"/>
    <material name="charger_accent" rgba="0.85 0.12 0.12 1" specular="0.6" shininess="0.7"/>
    <material name="charger_metal" rgba="0.6 0.6 0.62 1" specular="0.9" shininess="0.95"/>
    <material name="charger_cable" rgba="0.15 0.15 0.15 1" specular="0.1" shininess="0.2"/>
  </asset>

  <worldbody>
    <!-- Main sun light with shadows -->
    <light pos="4 -3 6" dir="-0.3 0.3 -1" directional="true" castshadow="true"
           diffuse="0.8 0.75 0.7" ambient="0.15 0.15 0.2" specular="0.3 0.3 0.3"/>
    <!-- Fill light (no shadows) for softer look -->
    <light pos="0 3 4" dir="0 -0.3 -1" directional="false" castshadow="false"
           diffuse="0.2 0.25 0.3" specular="0.1 0.1 0.1"/>

    <!-- Ground plane (larger for navigation) -->
    <geom name="floor" size="10 10 0.05" type="plane" material="groundplane"/>

    <!-- ============================================ -->
    <!-- OIL BARRELS - 3 in a row at x=2.5 -->
    <!-- Actual mass 0.3kg (easy to push) - robot is told ~5kg -->
    <!-- Rotated 90° around X to stand upright (Y-up to Z-up) -->
    <!-- ============================================ -->
    <body name="barrel_1_body" pos="2.5 -0.7 0.01">
      <freejoint/>
      <geom name="barrel_1" type="mesh" mesh="barrel" euler="1.5708 0 0" material="barrel_mat2"
            mass="0.3" contype="1" conaffinity="1"/>
    </body>
    <body name="barrel_2_body" pos="2.5 0 0.01">
      <freejoint/>
      <geom name="barrel_2" type="mesh" mesh="barrel" euler="1.5708 0 0" material="barrel_mat1"
            mass="0.3" contype="1" conaffinity="1"/>
    </body>
    <body name="barrel_3_body" pos="2.5 0.7 0.01">
      <freejoint/>
      <geom name="barrel_3" type="mesh" mesh="barrel" euler="1.5708 0 0" material="barrel_mat3"
            mass="0.3" contype="1" conaffinity="1"/>
    </body>

    <!-- ============================================ -->
    <!-- GOAL - Charging Station at (5.0, 0.0) -->
    <!-- Tesla Supercharger V3 style -->
    <!-- ============================================ -->
    <!-- Base plate -->
    <geom name="charger_baseplate" type="cylinder" size="0.3 0.015"
          pos="5 0 0.015" material="charger_body_dark" contype="1" conaffinity="1"/>
    <!-- Main column (cylinder for rounded look) -->
    <geom name="goal_pole" type="cylinder" size="0.12 0.75"
          pos="5 0 0.78" material="charger_body" contype="1" conaffinity="1"/>
    <!-- Top cap -->
    <geom name="charger_cap" type="cylinder" size="0.14 0.04"
          pos="5 0 1.57" material="charger_body" contype="0" conaffinity="0"/>
    <!-- Red accent band -->
    <geom name="charger_band" type="cylinder" size="0.125 0.025"
          pos="5 0 1.5" material="charger_accent" contype="0" conaffinity="0"/>
    <!-- Screen housing -->
    <geom name="charger_screen_frame" type="box" size="0.10 0.02 0.15"
          pos="5 -0.11 1.2" material="charger_body_dark" contype="0" conaffinity="0"/>
    <!-- Screen (glossy black) -->
    <geom name="charger_screen" type="box" size="0.08 0.005 0.12"
          pos="5 -0.125 1.2" material="charger_screen" contype="0" conaffinity="0"/>
    <!-- Cable holder -->
    <geom name="charger_holder" type="cylinder" size="0.04 0.08" euler="1.5708 0 0"
          pos="5 -0.14 0.9" material="charger_metal" contype="0" conaffinity="0"/>
    <!-- Cable (hanging) -->
    <geom name="charger_cable1" type="capsule" size="0.02 0.15"
          pos="5 -0.2 0.75" euler="0.3 0 0" material="charger_cable" contype="0" conaffinity="0"/>
    <!-- Connector plug -->
    <geom name="charger_plug" type="box" size="0.035 0.025 0.06"
          pos="5 -0.28 0.55" material="charger_body" contype="0" conaffinity="0"/>

    <!-- ============================================ -->
    <!-- START (BLUE) - at (0.0, 0.0) -->
    <!-- ============================================ -->
    <geom name="start_marker" type="cylinder"
          pos="0 0 0.01" size="0.25 0.01"
          material="start_mat" contype="0" conaffinity="0"/>

    <!-- ============================================ -->
    <!-- CAMERAS FOR VISUALIZATION -->
    <!-- ============================================ -->
    <!-- Overhead camera - bird's eye view, zoomed in on goal area -->
    <camera name="overhead" pos="3.5 0 4" xyaxes="1 0 0 0 1 0" fovy="50"/>

    <!-- Side view camera - shows depth and height -->
    <camera name="side_view" pos="2.5 -6 2" xyaxes="1 0 0 0 0 1" fovy="50"/>

    <!-- Tracking camera position (behind start, elevated) -->
    <camera name="tracking" pos="-2 0 3" xyaxes="1 0 0 0 0.3 1" fovy="60"/>
  </worldbody>
</mujoco>
