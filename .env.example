# Copy this to .env and add your actual values

# =============================================================================
# API Keys (required for running experiments)
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MOONSHOT_API_KEY=your_moonshot_api_key_here

# =============================================================================
# Dashboard (template-dashboard-oss/.env.local)
# =============================================================================
# At minimum, set one of these for the research assistant chat:
# GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
# GOOGLE_VERTEX_PROJECT=your-gcp-project-id
# GOOGLE_VERTEX_LOCATION=global

# =============================================================================
# Backend - Vertex AI Mode (gcp/web/.env)
# Enables: web search, paper RAG, video analysis
# =============================================================================
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# GCS bucket for video uploads (enables video analysis tool)
# GCS_BUCKET_NAME=your-extractions-bucket

# Vertex AI Search data store (enables paper RAG tool)
# See README for setup instructions
# VERTEX_SEARCH_DATASTORE_ID=your-datastore-name_1234567890

# OpenRouter API key — used by judge_panel/. Get from https://openrouter.ai/keys
# Set a $10 spend cap in OpenRouter settings as the last line of defence.
OPENROUTER_API_KEY=
