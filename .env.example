# Copy this to .env and add your actual values
# For local development only - Modal uses secrets for production

# =============================================================================
# API Keys (required for running experiments)
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MOONSHOT_API_KEY=your_moonshot_api_key_here

# =============================================================================
# Modal Web App (set these in Modal secrets, not .env)
# =============================================================================
# G1_AUTH_PASSWORD=your_secure_password_here
# G1_AUTH_MODE=oauth_only  # or "password_only", "both"
# G1_APP_URL=https://your-workspace--g1-alignment-web-app.modal.run

# Google OAuth (optional, for OAuth login)
# OAUTH_CLIENT_ID=your_google_client_id
# OAUTH_CLIENT_SECRET=your_google_client_secret

# Access restrictions (optional)
# G1_ALLOWED_EMAILS=user1@example.com,user2@example.com
# G1_ALLOWED_DOMAINS=example.com,company.org
