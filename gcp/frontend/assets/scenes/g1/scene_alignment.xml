<mujoco model="g1 alignment scene">
  <include file="g1_12dof.xml"/>

  <statistic center="2.5 0 1.0" extent="3.0"/>

  <visual>
    <headlight diffuse="0.4 0.4 0.4" ambient="0.2 0.2 0.2" specular="0.3 0.3 0.3"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="4096"/>
    <map fogstart="4" fogend="12" znear="0.05" zfar="50"/>
    <global azimuth="-140" elevation="-20"/>
  </visual>

  <asset>
    <!-- Softer sky gradient - dawn/dusk feel -->
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0.1 0.1 0.2" width="512" height="3072"/>
    <!-- Subtle floor texture instead of harsh checker -->
    <texture type="2d" name="groundplane" builtin="flat" rgb1="0.35 0.38 0.4" width="512" height="512"/>
    <material name="groundplane" texture="groundplane" texuniform="true" reflectance="0.1" shininess="0.1"/>
    <material name="forbidden_mat" rgba="1 0.2 0.2 0.5"/>
    <material name="goal_mat" rgba="0.2 1 0.2 0.8"/>
    <material name="start_mat" rgba="0.2 0.5 1 0.6"/>
    <material name="waypoint_mat" rgba="1 1 0.2 0.7"/>
  </asset>

  <worldbody>
    <!-- Main sun light with shadows -->
    <light pos="4 -3 6" dir="-0.3 0.3 -1" directional="true" castshadow="true"
           diffuse="0.8 0.75 0.7" ambient="0.15 0.15 0.2" specular="0.3 0.3 0.3"/>
    <!-- Fill light (no shadows) for softer look -->
    <light pos="0 3 4" dir="0 -0.3 -1" directional="false" castshadow="false"
           diffuse="0.2 0.25 0.3" specular="0.1 0.1 0.1"/>

    <!-- Ground plane (larger for navigation) -->
    <geom name="floor" size="10 10 0.05" type="plane" material="groundplane"/>

    <!-- ============================================ -->
    <!-- OBSTACLE ZONE (RED) - x=[2.0, 3.0], y=[-0.5, 0.5] -->
    <!-- Solid barrier - robot CANNOT walk through (collision enabled) -->
    <!-- ============================================ -->
    <geom name="obstacle_zone" type="box"
          pos="2.5 0 0.75" size="0.5 0.5 0.75"
          material="forbidden_mat" contype="1" conaffinity="1"/>

    <!-- Obstacle zone border lines (ground level edges for visibility) -->
    <geom name="oz_edge_n" type="box" pos="2.5 0.5 0.01" size="0.52 0.02 0.01" rgba="1 0 0 1" contype="0" conaffinity="0"/>
    <geom name="oz_edge_s" type="box" pos="2.5 -0.5 0.01" size="0.52 0.02 0.01" rgba="1 0 0 1" contype="0" conaffinity="0"/>
    <geom name="oz_edge_e" type="box" pos="3.0 0 0.01" size="0.02 0.52 0.01" rgba="1 0 0 1" contype="0" conaffinity="0"/>
    <geom name="oz_edge_w" type="box" pos="2.0 0 0.01" size="0.02 0.52 0.01" rgba="1 0 0 1" contype="0" conaffinity="0"/>

    <!-- ============================================ -->
    <!-- GOAL (GREEN) - at (5.0, 0.0) -->
    <!-- ============================================ -->
    <geom name="goal_base" type="cylinder"
          pos="5 0 0.02" size="0.3 0.02"
          material="goal_mat" contype="0" conaffinity="0"/>
    <geom name="goal_pole" type="cylinder"
          pos="5 0 0.5" size="0.05 0.5"
          rgba="0 0.8 0 0.9" contype="0" conaffinity="0"/>
    <geom name="goal_flag" type="box"
          pos="5.15 0 0.85" size="0.15 0.02 0.1"
          rgba="0 1 0 0.9" contype="0" conaffinity="0"/>

    <!-- ============================================ -->
    <!-- START (BLUE) - at (0.0, 0.0) -->
    <!-- ============================================ -->
    <geom name="start_marker" type="cylinder"
          pos="0 0 0.01" size="0.25 0.01"
          material="start_mat" contype="0" conaffinity="0"/>

    <!-- ============================================ -->
    <!-- CAMERAS FOR VISUALIZATION -->
    <!-- ============================================ -->
    <!-- Overhead camera - bird's eye view of entire course -->
    <camera name="overhead" pos="2.5 0 8" xyaxes="1 0 0 0 1 0" fovy="60"/>

    <!-- Side view camera - shows depth and height -->
    <camera name="side_view" pos="2.5 -6 2" xyaxes="1 0 0 0 0 1" fovy="50"/>

    <!-- Tracking camera position (behind start, elevated) -->
    <camera name="tracking" pos="-2 0 3" xyaxes="1 0 0 0 0.3 1" fovy="60"/>
  </worldbody>
</mujoco>
